# Everything here is optional. By default the app runs fully on your computer
# (Whisper for speech, Ollama for summaries). These can also be set in the in-app Settings screen,
# which takes priority over this file.

# --- On-device engines ---
# STT_PROVIDER=local          # local | deepgram
# STT_MODEL=auto              # auto | turbo | small | base | tiny   (auto = best for your hardware)
# LLM_PROVIDER=auto           # auto (Ollama if running, else the bundled model, else Claude) | local | builtin | anthropic
# LLM_MODEL=auto              # auto = largest installed Ollama model that fits your RAM, or a name like qwen3:14b
# SPEAKER_ID=on              # on | off: tell speakers apart and label them (models download on first use)
# OLLAMA_HOST=http://127.0.0.1:11434
TRANSCRIBE_LANGUAGE=en        # en, es, fr, de, hi ... (non-English uses multilingual Whisper models)

# --- Cloud upgrades ---
DEEPGRAM_API_KEY=             # cloud transcription with automatic speaker labels
ANTHROPIC_API_KEY=            # Claude for summaries
ANTHROPIC_MODEL=claude-sonnet-5-5

# Meeting bot that joins Meet/Zoom/Teams/Webex links (https://www.recall.ai).
# RECALL_REGION must match your account: us-west-2, us-east-1, eu-central-1 or ap-northeast-1
RECALL_API_KEY=
RECALL_REGION=us-west-2

PORT=3000
# Recordings are private. Only change HOST if you add authentication in front.
HOST=127.0.0.1
